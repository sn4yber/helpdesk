---
import Alerta from '../../components/Alerta.astro';
import Layout from '../../layouts/Layout.astro';
import { readFlash } from '../../lib/flash';

const flash = readFlash(Astro.cookies);
const fields = flash?.fields ?? {};
const campo = 'form-control';
---

<Layout title="Nuevo ticket">
  <div class="mx-auto max-w-4xl">
    <a href="/tickets" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-blue-700">
      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      Volver a tickets
    </a>

    <div class="mt-5 flex items-start gap-4">
      <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-600/20">
        <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
      </span>
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-950">Registrar ticket</h1>
        <p class="mt-1 text-sm text-slate-500">Completa la información del cliente y describe la incidencia.</p>
      </div>
    </div>

    <form method="post" action="/api/tickets" class="surface mt-7 overflow-hidden">
      <div class="border-b border-slate-100 bg-slate-50/70 px-5 py-4 sm:px-7">
        <div class="flex items-center gap-3">
          <span class="grid size-8 place-items-center rounded-lg bg-blue-100 text-sm font-bold text-blue-700">1</span>
          <div>
            <h2 class="text-sm font-bold text-slate-800">Información del cliente</h2>
            <p class="text-xs text-slate-500">Todos los campos de esta sección son obligatorios.</p>
          </div>
        </div>
      </div>

      <div class="space-y-5 p-5 sm:p-7">
        <Alerta errores={flash?.errors} />

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="nombre" class="mb-2 block text-sm font-semibold text-slate-700">Nombre</label>
            <input id="nombre" name="nombre" required maxlength="80" value={fields.nombre ?? ''} placeholder="Ej. Andrea" class={campo} />
          </div>
          <div>
            <label for="apellido" class="mb-2 block text-sm font-semibold text-slate-700">Apellido</label>
            <input id="apellido" name="apellido" required maxlength="80" value={fields.apellido ?? ''} placeholder="Ej. Rodríguez" class={campo} />
          </div>
          <div>
            <label for="direccion" class="mb-2 block text-sm font-semibold text-slate-700">Dirección</label>
            <input id="direccion" name="direccion" required maxlength="200" value={fields.direccion ?? ''} placeholder="Dirección de residencia" class={campo} />
          </div>
          <div>
            <label for="telefono" class="mb-2 block text-sm font-semibold text-slate-700">Teléfono</label>
            <input
              id="telefono"
              name="telefono"
              type="tel"
              required
              minlength="7"
              maxlength="30"
              pattern="[0-9+\-() ]{7,30}"
              title="Dígitos, espacios, +, - y paréntesis"
              value={fields.telefono ?? ''}
              placeholder="+57 300 000 0000"
              class={campo}
            />
          </div>
        </div>

        <div class="border-t border-slate-100 pt-5">
          <label for="nota" class="mb-2 block text-sm font-semibold text-slate-700">
            Nota inicial <span class="font-normal text-slate-400">(opcional)</span>
          </label>
          <textarea id="nota" name="nota" maxlength="1000" rows="5" placeholder="Describe brevemente la solicitud o incidencia reportada..." class={campo}>{fields.nota ?? ''}</textarea>
          <p class="mt-2 text-xs text-slate-400">Máximo 1000 caracteres.</p>
        </div>
      </div>

      <div class="flex flex-col-reverse gap-3 border-t border-slate-100 bg-slate-50/60 px-5 py-4 sm:flex-row sm:justify-end sm:px-7">
        <a href="/tickets" class="btn-secondary">Cancelar</a>
        <button type="submit" class="btn-primary">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          Crear ticket
        </button>
      </div>
    </form>
  </div>
</Layout>
