---
import Alerta from '../../components/Alerta.astro';
import EstadoBadge from '../../components/EstadoBadge.astro';
import MensajeExito from '../../components/MensajeExito.astro';
import Layout from '../../layouts/Layout.astro';
import { ESTADOS, bordeEstado, etiquetaEstado, esEstado } from '../../lib/estados';
import { readFlash } from '../../lib/flash';
import { formatoFecha } from '../../lib/format';
import { contarPorEstado, listarTickets } from '../../lib/tickets';

const estadoParam = Astro.url.searchParams.get('estado') ?? '';
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const estado = esEstado(estadoParam) ? estadoParam : '';
const flash = readFlash(Astro.cookies);

const [totales, tickets] = await Promise.all([
  contarPorEstado(),
  listarTickets(estado || null, q || null),
]);

function enlaceEstado(valor: string) {
  const params = new URLSearchParams();
  params.set('estado', valor);
  if (q) params.set('q', q);
  return `/tickets?${params}`;
}
---

<Layout title="Tickets">
  <p class="text-xs font-semibold uppercase tracking-[.16em] text-blue-600">Panel de soporte</p>
  <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-950">Todos los tickets</h1>
      <p class="mt-2 text-sm text-slate-500">Consulta y gestiona las incidencias registradas.</p>
    </div>
    <a
      href="/tickets/nuevo"
      class="btn-primary"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
      Nuevo ticket
    </a>
  </div>

  {
    (flash?.success || flash?.errors?.length) && (
      <div class="mt-6 space-y-3">
        <MensajeExito mensaje={flash?.success} />
        <Alerta errores={flash?.errors} />
      </div>
    )
  }

  <div class="mt-7 grid grid-cols-2 gap-3 xl:grid-cols-4">
    {
      ESTADOS.map((item) => (
        <a
          href={enlaceEstado(item)}
          class:list={[
            'group relative overflow-hidden rounded-2xl border border-slate-200/80 border-l-4 bg-white p-4 shadow-sm shadow-slate-200/50 hover:-translate-y-0.5 hover:shadow-md',
            bordeEstado(item),
            estado === item && 'ring-2 ring-blue-500 ring-offset-2',
          ]}
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-semibold text-slate-500">{etiquetaEstado(item)}</p>
              <p class="mt-2 text-3xl font-bold tabular-nums tracking-tight text-slate-950">{totales[item]}</p>
            </div>
            <span class:list={[
              'grid size-9 shrink-0 place-items-center rounded-xl',
              item === 'En proceso' && 'bg-blue-50 text-blue-600',
              item === 'Atendido' && 'bg-amber-50 text-amber-600',
              item === 'Finalizado' && 'bg-emerald-50 text-emerald-600',
              item === 'Escalado' && 'bg-red-50 text-red-600',
            ]}>
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5V9a2 2 0 0 0 0 4v3.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 16.5V13a2 2 0 0 0 0-4Z" />
              </svg>
            </span>
          </div>
        </a>
      ))
    }
  </div>

  <form method="get" class="surface mt-6 flex flex-col gap-3 p-3 sm:flex-row sm:items-center">
    <div class="relative flex-1">
      <label for="q" class="sr-only">Buscar</label>
      <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 size-5 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" />
      </svg>
      <input
        id="q"
        name="q"
        type="search"
        value={q}
        maxlength="120"
        placeholder="Buscar por código o nombre del cliente..."
        class="form-control ps-11"
      />
    </div>
    <div class="sm:w-64">
      <label for="estado" class="sr-only">Estado</label>
      <select
        id="estado"
        name="estado"
        class="form-control"
        onchange="this.form.requestSubmit()"
      >
        <option value="" selected={estado === ''}>Todos</option>
        {
          ESTADOS.map((item) => (
            <option value={item} selected={estado === item}>
              {etiquetaEstado(item)}
            </option>
          ))
        }
      </select>
    </div>
    <div class="flex gap-2">
      <button type="submit" class="btn-primary">
        Buscar
      </button>
      <a
        href="/tickets"
        class="btn-secondary"
      >
        Limpiar
      </a>
    </div>
  </form>

  <div class="surface mt-5 overflow-hidden">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-3">
      <p class="text-xs font-medium text-slate-500">
        {tickets.length} {tickets.length === 1 ? 'ticket encontrado' : 'tickets encontrados'}
      </p>
      {(q || estado) && <span class="text-xs font-semibold text-blue-600">Filtros activos</span>}
    </div>
    {
      tickets.length === 0 ? (
        <div class="px-4 py-16 text-center">
          <span class="mx-auto grid size-12 place-items-center rounded-full bg-slate-100 text-slate-400">
            <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
          </span>
          <p class="mt-4 text-sm font-semibold text-slate-700">No encontramos tickets</p>
          <p class="mt-1 text-xs text-slate-500">Prueba con otro término o estado.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="min-w-full text-left text-sm">
            <thead class="border-b border-slate-200 bg-slate-50/80 text-[11px] uppercase tracking-[.08em] text-slate-500">
              <tr>
                <th class="px-5 py-4 font-semibold">Código</th>
                <th class="px-5 py-4 font-semibold">Cliente</th>
                <th class="px-5 py-4 font-semibold">Teléfono</th>
                <th class="px-5 py-4 font-semibold">Estado</th>
                <th class="px-5 py-4 font-semibold">Creado</th>
                <th class="w-12 px-5 py-4"><span class="sr-only">Abrir</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {tickets.map((ticket) => (
                <tr class="group hover:bg-blue-50/40">
                  <td class="px-5 py-4">
                    <a
                      href={`/tickets/${ticket.codigo}`}
                      class="font-mono text-sm font-bold text-blue-700 underline-offset-2 hover:underline"
                    >
                      {ticket.codigo}
                    </a>
                  </td>
                  <td class="px-5 py-4">
                    <div class="flex items-center gap-3">
                      <span class="grid size-9 shrink-0 place-items-center rounded-full bg-slate-100 text-xs font-bold text-slate-600">
                        {ticket.nombre.charAt(0)}{ticket.apellido.charAt(0)}
                      </span>
                      <span class="font-semibold text-slate-800">{ticket.nombre} {ticket.apellido}</span>
                    </div>
                  </td>
                  <td class="px-5 py-4 whitespace-nowrap text-slate-600">{ticket.telefono}</td>
                  <td class="px-5 py-4">
                    <EstadoBadge estado={ticket.estado_actual} />
                  </td>
                  <td class="px-5 py-4 whitespace-nowrap text-slate-500">{formatoFecha(ticket.created_at)}</td>
                  <td class="px-5 py-4">
                    <a href={`/tickets/${ticket.codigo}`} class="grid size-8 place-items-center rounded-lg text-slate-400 group-hover:bg-white group-hover:text-blue-600" aria-label={`Abrir ${ticket.codigo}`}>
                      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</Layout>
