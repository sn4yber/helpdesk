---
import Alerta from '../../components/Alerta.astro';
import EstadoBadge from '../../components/EstadoBadge.astro';
import MensajeExito from '../../components/MensajeExito.astro';
import Layout from '../../layouts/Layout.astro';
import { ESTADOS, etiquetaEstado, puntoEstado } from '../../lib/estados';
import { readFlash } from '../../lib/flash';
import { formatoFecha } from '../../lib/format';
import { listarSeguimientos, obtenerTicket } from '../../lib/tickets';

const codigo = Astro.params.codigo ?? '';
const ticket = await obtenerTicket(codigo);
if (!ticket) Astro.response.status = 404;

const seguimientos = ticket ? await listarSeguimientos(ticket.id) : [];
const flash = readFlash(Astro.cookies);
const fields = flash?.fields ?? {};
const opciones = ticket ? ESTADOS.filter((estado) => estado !== ticket.estado_actual) : [];
const campo = 'form-control';
---

<Layout title={ticket ? ticket.codigo : 'Ticket no encontrado'}>
  <a href="/tickets" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-blue-700">
    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
    Volver a tickets
  </a>

  {
    !ticket ? (
      <div class="surface mt-6 px-6 py-16 text-center">
        <span class="mx-auto grid size-14 place-items-center rounded-full bg-slate-100 text-slate-400">
          <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 9v4M12 17h.01" /><path d="M10.3 3.6 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.6a2 2 0 0 0-3.4 0Z" /></svg>
        </span>
        <h1 class="mt-4 text-xl font-bold">Ticket no encontrado</h1>
        <p class="mt-2 text-sm text-slate-500">No existe un caso con el código {codigo}.</p>
      </div>
    ) : (
      <div class="mt-5 space-y-6">
        <div class="surface flex flex-wrap items-center justify-between gap-5 p-5 sm:p-6">
          <div>
            <div class="flex flex-wrap items-center gap-3">
              <h1 class="font-mono text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">{ticket.codigo}</h1>
              <EstadoBadge estado={ticket.estado_actual} />
            </div>
            <p class="mt-2 text-sm text-slate-500">Seguimiento y actividad de la incidencia</p>
          </div>
          <div class="flex items-center gap-3">
            <span class="grid size-11 place-items-center rounded-full bg-blue-100 text-sm font-bold text-blue-700">
              {ticket.nombre.charAt(0)}{ticket.apellido.charAt(0)}
            </span>
            <div>
              <p class="text-sm font-bold text-slate-800">{ticket.nombre} {ticket.apellido}</p>
              <p class="text-xs text-slate-500">{ticket.telefono}</p>
            </div>
          </div>
        </div>

        <MensajeExito mensaje={flash?.success} />

        <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
          <section class="surface overflow-hidden">
            <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4 sm:px-6">
              <div>
                <h2 class="font-bold text-slate-800">Línea de tiempo</h2>
                <p class="mt-0.5 text-xs text-slate-500">{seguimientos.length} {seguimientos.length === 1 ? 'actualización' : 'actualizaciones'}</p>
              </div>
              <span class="grid size-9 place-items-center rounded-xl bg-slate-100 text-slate-500">
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
              </span>
            </div>
            <ol class="space-y-0 px-5 py-2 sm:px-6">
              {seguimientos.map((item) => (
                <li class="relative border-s-2 border-slate-100 py-5 ps-7 last:border-transparent">
                  <span
                    class:list={[
                      'absolute -start-[7px] top-7 size-3 rounded-full ring-4 ring-white',
                      puntoEstado(item.estado),
                    ]}
                  />
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <EstadoBadge estado={item.estado} />
                    <span class="text-xs text-slate-400">{formatoFecha(item.created_at)}</span>
                  </div>
                  <p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-slate-700">
                    {item.nota?.trim() ? item.nota : <span class="italic text-slate-400">Sin nota registrada</span>}
                  </p>
                  <div class="mt-3 flex items-center gap-2 text-xs text-slate-500">
                    <span class="grid size-6 place-items-center rounded-full bg-slate-100 text-[10px] font-bold text-slate-600">{(item.agente_nombre ?? 'A').charAt(0)}</span>
                    {item.agente_nombre ?? 'Agente no disponible'}
                  </div>
                </li>
              ))}
            </ol>
          </section>

          <aside class="space-y-5 xl:sticky xl:top-8">
            <section class="surface overflow-hidden">
              <div class="border-b border-slate-100 px-5 py-4">
                <h2 class="font-bold text-slate-800">Datos del caso</h2>
              </div>
              <dl class="divide-y divide-slate-100 px-5 text-sm">
                <div>
                  <dt class="pt-4 text-xs font-medium text-slate-400">Dirección</dt>
                  <dd class="pb-4 pt-1 font-medium text-slate-700">{ticket.direccion}</dd>
                </div>
                <div>
                  <dt class="pt-4 text-xs font-medium text-slate-400">Registrado por</dt>
                  <dd class="pb-4 pt-1 font-medium text-slate-700">{ticket.agente_nombre ?? '—'}</dd>
                </div>
                <div>
                  <dt class="pt-4 text-xs font-medium text-slate-400">Fecha de creación</dt>
                  <dd class="pb-4 pt-1 font-medium text-slate-700">{formatoFecha(ticket.created_at)}</dd>
                </div>
                <div>
                  <dt class="pt-4 text-xs font-medium text-slate-400">Última actualización</dt>
                  <dd class="pb-4 pt-1 font-medium text-slate-700">{formatoFecha(ticket.updated_at)}</dd>
                </div>
              </dl>
            </section>

            <Alerta errores={flash?.errors} />
            {
              ticket.estado_actual === 'Finalizado' ? (
                <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5">
                  <span class="grid size-10 place-items-center rounded-full bg-emerald-100 text-emerald-700">
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                  </span>
                  <p class="mt-3 text-sm font-bold text-emerald-900">Caso finalizado</p>
                  <p class="mt-1 text-xs leading-5 text-emerald-700">Este ticket no admite más cambios de estado.</p>
                </div>
              ) : (
                <form method="post" action={`/api/tickets/${ticket.codigo}/seguimientos`} class="surface p-5">
                  <h2 class="font-bold text-slate-800">Actualizar estado</h2>
                  <p class="mt-1 text-xs text-slate-500">Registra el siguiente paso del caso.</p>
                  <div class="mt-5 space-y-4">
                    <div>
                      <label for="estado" class="mb-2 block text-sm font-semibold text-slate-700">Nuevo estado</label>
                      <select id="estado" name="estado" required class={campo}>
                        <option value="" disabled selected={!fields.estado}>Selecciona un estado</option>
                        {opciones.map((estado) => (
                          <option value={estado} selected={fields.estado === estado}>{etiquetaEstado(estado)}</option>
                        ))}
                      </select>
                    </div>
                    <div>
                      <label for="nota" class="mb-2 block text-sm font-semibold text-slate-700">
                        Nota <span class="font-normal text-slate-400">(opcional)</span>
                      </label>
                      <textarea id="nota" name="nota" maxlength="1000" rows="4" placeholder="Describe el avance realizado..." class={campo}>{fields.nota ?? ''}</textarea>
                    </div>
                  </div>
                  <p class="mt-2 text-xs leading-5 text-slate-400">Al escalar, indica la dependencia destino.</p>
                  <button type="submit" class="btn-primary mt-4 w-full">Registrar cambio</button>
                </form>
              )
            }

            <section class="rounded-2xl border border-red-200 bg-white p-5 shadow-sm shadow-red-100/50">
              <h2 class="text-sm font-bold text-slate-800">Zona de peligro</h2>
              <p class="mt-1 text-xs leading-5 text-slate-500">
                Elimina el ticket y todo su historial de seguimiento.
              </p>
              <button
                type="button"
                class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-bold text-red-700 hover:bg-red-100 focus:outline-none focus:ring-4 focus:ring-red-100"
                onclick="document.getElementById('delete-dialog')?.showModal()"
              >
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5" />
                </svg>
                Eliminar ticket
              </button>
            </section>
          </aside>
        </div>

        <dialog
          id="delete-dialog"
          class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border-0 bg-white p-0 shadow-2xl backdrop:bg-slate-950/50 backdrop:backdrop-blur-sm"
          onclick="if (event.target === this) this.close()"
        >
          <form method="post" action={`/api/tickets/${ticket.codigo}/eliminar`} class="p-6">
            <span class="grid size-12 place-items-center rounded-full bg-red-100 text-red-700">
              <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13" />
              </svg>
            </span>
            <h2 class="mt-4 text-xl font-bold tracking-tight text-slate-950">¿Eliminar {ticket.codigo}?</h2>
            <p class="mt-2 text-sm leading-6 text-slate-500">
              Se eliminarán permanentemente el ticket y sus {seguimientos.length} {seguimientos.length === 1 ? 'seguimiento' : 'seguimientos'}. El cliente se conservará.
            </p>
            <p class="mt-3 rounded-lg bg-red-50 px-3 py-2 text-xs font-semibold text-red-700">
              Esta acción no se puede deshacer.
            </p>
            <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
              <button type="button" class="btn-secondary" onclick="this.closest('dialog')?.close()">Cancelar</button>
              <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-red-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-red-700">
                Sí, eliminar
              </button>
            </div>
          </form>
        </dialog>
      </div>
    )
  }
</Layout>
