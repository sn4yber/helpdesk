---
import Alerta from '../components/Alerta.astro';
import Layout from '../layouts/Layout.astro';
import { readFlash } from '../lib/flash';

const flash = readFlash(Astro.cookies);
const usuario = flash?.fields?.usuario ?? '';
---

<Layout title="Iniciar sesión">
  <div class="grid min-h-screen lg:grid-cols-2">
    <section class="relative hidden overflow-hidden bg-blue-700 p-12 text-white lg:flex lg:flex-col lg:justify-between">
      <div class="absolute -left-32 -top-32 size-96 rounded-full bg-cyan-400/20 blur-3xl"></div>
      <div class="absolute -bottom-40 -right-24 size-[30rem] rounded-full bg-indigo-950/30 blur-3xl"></div>

      <div class="relative z-10 flex items-center gap-3">
        <span class="grid size-11 place-items-center rounded-xl bg-white text-blue-700 shadow-xl shadow-blue-950/20">
          <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 13a8 8 0 0 1 16 0" />
            <path d="M18 19h-1a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h3v5a3 3 0 0 1-3 3Z" />
            <path d="M6 19h1a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2H4v5a3 3 0 0 0 3 3Z" />
          </svg>
        </span>
        <div>
          <p class="text-xl font-bold tracking-tight">Helpdesk</p>
          <p class="text-xs font-medium text-blue-200">Centro de soporte</p>
        </div>
      </div>

      <div class="relative z-10 mx-auto w-full max-w-lg">
        <div class="relative mx-auto mb-10 grid aspect-square max-w-sm place-items-center">
          <span class="absolute inset-8 rounded-full border border-white/10 bg-white/5"></span>
          <span class="absolute inset-20 rounded-full border border-white/15"></span>
          <div class="relative grid size-40 place-items-center rounded-[2.25rem] bg-white shadow-2xl shadow-blue-950/30">
            <svg viewBox="0 0 120 120" class="size-28" fill="none" aria-hidden="true">
              <circle cx="60" cy="60" r="45" fill="#DBEAFE" />
              <path d="M33 62a27 27 0 0 1 54 0" stroke="#2563EB" stroke-width="8" stroke-linecap="round" />
              <rect x="25" y="59" width="18" height="30" rx="8" fill="#1D4ED8" />
              <rect x="77" y="59" width="18" height="30" rx="8" fill="#1D4ED8" />
              <path d="M86 88c0 9-7 15-17 15h-7" stroke="#2563EB" stroke-width="6" stroke-linecap="round" />
              <rect x="55" y="97" width="18" height="9" rx="4.5" fill="#0F172A" />
              <circle cx="51" cy="70" r="3" fill="#0F172A" />
              <circle cx="70" cy="70" r="3" fill="#0F172A" />
              <path d="M52 82c5 4 11 4 16 0" stroke="#0F172A" stroke-width="3" stroke-linecap="round" />
            </svg>
          </div>
          <span class="absolute left-5 top-20 grid size-14 place-items-center rounded-2xl bg-cyan-400 shadow-lg shadow-blue-950/20">
            <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 5h16v12H7l-3 3Z" /></svg>
          </span>
          <span class="absolute bottom-16 right-4 grid size-14 place-items-center rounded-2xl bg-indigo-900 shadow-lg shadow-blue-950/20">
            <svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
          </span>
        </div>
        <h2 class="text-4xl font-bold leading-tight tracking-tight">Cada incidencia,<br />bajo control.</h2>
        <p class="mt-4 max-w-md text-base leading-7 text-blue-100">
          Registra, sigue y resuelve solicitudes desde un único espacio simple y ordenado.
        </p>
      </div>

      <p class="relative z-10 text-xs text-blue-200">Sistema interno de gestión de incidencias</p>
    </section>

    <section class="flex min-h-screen items-center justify-center bg-white px-5 py-10 sm:px-10">
      <div class="w-full max-w-md">
        <div class="mb-10 flex items-center gap-3 lg:hidden">
          <span class="grid size-10 place-items-center rounded-xl bg-blue-600 font-bold text-white">H</span>
          <strong class="text-xl tracking-tight">Helpdesk</strong>
        </div>

        <p class="text-sm font-semibold text-blue-600">Bienvenido de nuevo</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">Inicia sesión</h1>
        <p class="mt-3 text-sm leading-6 text-slate-500">Ingresa tus credenciales para acceder al panel de soporte.</p>

        <form method="post" action="/api/login" class="mt-8 space-y-5">
          <Alerta errores={flash?.errors} />

          <div>
            <label for="usuario" class="mb-2 block text-sm font-semibold text-slate-700">Usuario</label>
            <div class="relative">
              <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 size-5 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
              </svg>
              <input
                id="usuario"
                name="usuario"
                type="text"
                required
                maxlength="150"
                autocomplete="username"
                value={usuario}
                placeholder="Ingresa tu usuario"
                class="form-control py-3 ps-11"
              />
            </div>
          </div>

          <div>
            <label for="contrasena" class="mb-2 block text-sm font-semibold text-slate-700">Contraseña</label>
            <div class="relative">
              <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3.5 top-1/2 size-5 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" />
              </svg>
              <input
                id="contrasena"
                name="contrasena"
                type="password"
                required
                autocomplete="current-password"
                placeholder="Ingresa tu contraseña"
                class="form-control py-3 ps-11"
              />
            </div>
          </div>

          <button type="submit" class="btn-primary w-full py-3">
            Ingresar al sistema
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </button>
        </form>
      </div>
    </section>
  </div>
</Layout>
