---
import { claseEstado, etiquetaEstado, puntoEstado } from '../lib/estados';

interface Props {
  estado: string;
}

const { estado } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold ring-1 ring-inset',
    claseEstado(estado),
  ]}
>
  <span class:list={['size-1.5 rounded-full', puntoEstado(estado)]}></span>
  {etiquetaEstado(estado)}
</span>
