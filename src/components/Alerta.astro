---
interface Props {
  errores?: string[];
}

const { errores = [] } = Astro.props;
---

{
  errores.length > 0 && (
    <div role="alert" class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc space-y-1 ps-5">
        {errores.map((error) => (
          <li>{error}</li>
        ))}
      </ul>
    </div>
  )
}
